# Jason LTL - Environment Variables Configuration
# Production credentials for server-side authentication to https://myportal.goglt.com
# NOTE: Store actual password in your Render.com dashboard environment variables or local .env

EMAIL=Jason@cylltd.com
PASS=

# Optional aliases supported by scraper
