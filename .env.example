# Jason LTL - Environment Variables Configuration
# Production credentials for server-side authentication to https://myportal.goglt.com
# NOTE: Store actual password in your Render.com dashboard environment variables or local .env

EMAIL=Jason@cylltd.com
PASS=

# Optional aliases supported by scraper
GOGLT_EMAIL=Jason@cylltd.com
GOGLT_PASSWORD=
GLT_EMAIL=Jason@cylltd.com
GLT_PASS=

# Chrome Puppeteer Headless mode (default true)
HEADLESS=true

# Server port (Render automatically assigns PORT; defaults to 3000)
PORT=3000

# Dispatch Email SMTP Service (Automated Booking Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=freightdataus@gmail.com
SMTP_PASS=
DISPATCH_EMAIL_TO=Jason@cylltd.com
